<Window x:Class="ChaosHouse.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaosemaja – pöörane maailm"
        Height="720"
        Width="1000"
        MinHeight="600"
        MinWidth="800">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="KAOSEMAJA"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,12,0">

                <TextBlock Text="Tegelaste hoidla"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <ComboBox ItemsSource="{Binding RepositoryTypes}"
                          SelectedItem="{Binding SelectedRepositoryType, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,8"
                          Padding="6"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"
                         Padding="6"
                         ToolTip="Otsi nime või tegelase tüübi järgi"/>

                <ListBox ItemsSource="{Binding VisibleMembers}"
                         SelectedItem="{Binding SelectedMember}"
                         DisplayMemberPath="Name"
                         MinHeight="150"/>

                <UniformGrid Columns="2"
                             Margin="0,10,0,0">

                    <Button Content="Lisa külmkapp"
                            Command="{Binding AddFridgeCommand}"
                            Margin="2"
                            Padding="6"/>

                    <Button Content="Lisa kummitus"
                            Command="{Binding AddGhostCommand}"
                            Margin="2"
                            Padding="6"/>

                    <Button Content="Lisa leiutaja"
                            Command="{Binding AddInventorCommand}"
                            Margin="2"
                            Padding="6"/>

                    <Button Content="Eemalda elanik"
                            Command="{Binding RemoveCommand}"
                            Margin="2"
                            Padding="6"/>
                </UniformGrid>

                <TextBlock Text="Tegelaste arv tüübi järgi"
                           FontWeight="Bold"
                           Margin="0,14,0,6"/>

                <TextBox Text="{Binding GroupedMemberSummary, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Column="1">

                <TextBlock Text="Valitud elanik"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding SelectedMember.Name, FallbackValue='Pole valitud'}"
                           FontSize="16"
                           Margin="0,4"/>

                <TextBlock Text="{Binding SelectedMember.TypeName, FallbackValue=''}"
                           Margin="0,4"/>

                <TextBlock Text="{Binding SelectedMember.Id, FallbackValue=''}"
                           Margin="0,4"/>

                <TextBlock Text="{Binding SelectedMember.Energy, Mode=OneWay, StringFormat='Energia: {0}/100', FallbackValue='Energia: -'}"
                           Margin="0,8,0,4"/>

                <ProgressBar Value="{Binding SelectedMember.Energy, Mode=OneWay, FallbackValue=0}"
                             Maximum="100"
                             Height="22"/>

                <TextBlock Text="Tegevuse sisend"
                           FontWeight="Bold"
                           Margin="0,18,0,6"/>

                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         MinHeight="32"/>

                <TextBlock Text="Külmkapp: lock / unlock. Kummitus: arv 0–100. Leiutaja: vidina nimi."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,6,0,0"/>

                <Button Content="Käivita tegevus"
                        Command="{Binding ExecuteActionCommand}"
                        Margin="0,10,0,0"
                        Padding="8"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Sündmuste logi"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,14,0,8"/>

        <TextBox Grid.Row="3"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
